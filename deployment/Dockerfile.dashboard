# Admin dashboard — static bundle served by nginx.
#
# The console is a pure SPA: no SSR, no server runtime. Shipping it as static
# files behind nginx rather than a Node process removes an entire class of
# production incident and drops the image from ~200 MB to ~50 MB.

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages/types/package.json  ./packages/types/
COPY packages/utils/package.json  ./packages/utils/
COPY packages/shared/package.json ./packages/shared/
COPY apps/admin-dashboard/package.json ./apps/admin-dashboard/
# Optional dependencies are NOT omitted here. Rollup ships its native binary
# (@rollup/rollup-linux-x64-musl on Alpine) as an optional dependency, and
# esbuild resolves its platform binary through a postinstall script. Skipping
# either produces a MODULE_NOT_FOUND at build time that looks like a code fault.
RUN npm ci

COPY . .
RUN npm run build -w @orbit/types \
 && npm run build -w @orbit/utils \
 && npm run build -w @orbit/shared \
 && npm run build -w @orbit/admin-dashboard

FROM nginx:1.27-alpine AS runtime
RUN addgroup -g 1001 -S web && adduser -u 1001 -S orbit -G web

COPY --from=build /app/apps/admin-dashboard/dist /usr/share/nginx/html
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

# nginx needs these writable as a non-root user.
RUN touch /var/run/nginx.pid \
 && chown -R orbit:web /var/cache/nginx /var/run/nginx.pid /usr/share/nginx/html

USER orbit
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- http://localhost:8080/healthz || exit 1
