{
  "name": "orbit-field",
  "version": "1.0.0",
  "private": true,
  "description": "Orbit Field \u2014 offline-first enterprise inspection platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/types",
    "packages/utils",
    "packages/shared",
    "apps/backend",
    "apps/mobile",
    "apps/admin-dashboard",
    "apps/client-portal"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "test": "vitest run && npm run test -w @orbit/admin-dashboard",
    "build:packages": "npm run build -w @orbit/types -w @orbit/utils -w @orbit/shared",
    "build:api": "npm run build:packages && npm run db:generate -w @orbit/backend && npm run build -w @orbit/backend && node scripts/vercel-api-output.mjs",
    "dev:backend": "npm run dev -w @orbit/backend",
    "dev:mobile": "npm run start -w @orbit/mobile",
    "db:migrate": "npm run db:migrate -w @orbit/backend",
    "db:seed": "npm run db:seed -w @orbit/backend",
    "infra:up": "docker compose -f deployment/docker-compose.yml up -d",
    "infra:down": "docker compose -f deployment/docker-compose.yml down",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/e2e-sync.mjs && node scripts/e2e-api.mjs && node scripts/e2e-admin.mjs && node scripts/e2e-dashboard-contract.mjs",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=4096 eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:e2e:production": "node scripts/e2e-production.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup.mjs --verify-only",
    "backup:storage": "node scripts/backup-storage.mjs --check",
    "security:audit": "node scripts/security-audit.mjs",
    "build:portal": "npm run build:packages && npm run build -w @orbit/client-portal"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true
  }
}
