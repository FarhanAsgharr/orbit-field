# Orbit Field — environment template.
# Copy to .env and fill in. The API validates this at boot and refuses to start
# on anything missing or malformed, so a typo fails loudly at deploy time.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=debug

# --- data stores -----------------------------------------------------------
DATABASE_URL=postgresql://orbit:orbit_dev_password@localhost:5432/orbit_field?schema=public
# Migrations connect here instead. Locally it is the same server; on a pooled
# deployment it must be the direct port, because a transaction pooler cannot
# run the DDL and advisory locks that `prisma migrate` needs.
DIRECT_URL=postgresql://orbit:orbit_dev_password@localhost:5432/orbit_field?schema=public
REDIS_URL=redis://localhost:6379

# --- secrets ---------------------------------------------------------------
# Generate each independently:  openssl rand -base64 48
# The access and refresh secrets MUST differ — the API refuses to start in
# production if they match, because a single secret lets an access token be
# replayed as a refresh token.
JWT_ACCESS_SECRET=replace-me-with-48-bytes-of-base64-entropy-aaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48-bytes-of-entropy-bbbbbbbb
OTP_SECRET=replace-me-with-another-48-bytes-of-entropy-cccccccccccc

JWT_ISSUER=orbit-field
JWT_AUDIENCE=orbit-field-clients
# Short-lived by design; offline devices rely on the refresh token.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REMEMBER_ME_TTL_DAYS=180

OTP_TTL_SECONDS=600
OTP_LENGTH=6

# --- object storage --------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3 / MinIO / R2
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orbit-attachments
S3_ACCESS_KEY_ID=orbitadmin
S3_SECRET_ACCESS_KEY=orbitadmin_dev_secret
S3_FORCE_PATH_STYLE=true

# 5 MB chunks: small enough to resume cheaply on a bad link, large enough that
# a 40 MB video is not 400 round trips.
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_SESSION_TTL_HOURS=72
MAX_UPLOAD_BYTES=524288000

# --- sync tuning -----------------------------------------------------------
SYNC_PUSH_MAX_OPERATIONS=500
SYNC_PULL_MAX_CHANGES=1000
# A device offline longer than this is forced to re-bootstrap. Set it longer
# than your longest realistic field deployment.
SYNC_CHANGELOG_RETENTION_DAYS=90
SYNC_IDEMPOTENCY_RETENTION_DAYS=30

# --- security --------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=10
# Sync is generous by design: a device returning from a week offline makes many
# rapid calls to drain its queue, and throttling that looks identical to the
# outage it is recovering from. Uploads are chunked, so one large photo is many
# requests. Raise these for a large fleet rather than editing the code.
SYNC_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_MAX=300
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# Must be an explicit allowlist in production — '*' is rejected at boot.
CORS_ORIGINS=*
# Only enable behind a real proxy; otherwise callers can spoof their IP and
# defeat rate limiting.
TRUST_PROXY=false

# --- notifications ---------------------------------------------------------
SMTP_URL=
MAIL_FROM=Orbit Field <no-reply@orbitfield.app>
EXPO_ACCESS_TOKEN=

# --- serverless deployment (Vercel) ----------------------------------------
# Only needed when the API runs as a Vercel Function rather than a container.
# See docs/VERCEL.md for the full picture; the short version is below.
#
# Authorises the scheduled maintenance endpoint. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`; without it the endpoint refuses to run,
# because a prune loop anyone can trigger is a free denial-of-service.
#   openssl rand -hex 32
CRON_SECRET=

# A function instance has no writable disk that survives the invocation, so
# STORAGE_DRIVER must be s3 and point at Supabase Storage's S3-compatible
# endpoint:
#   STORAGE_DRIVER=s3
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION=<your project region, e.g. eu-central-1>
#   S3_BUCKET=orbit-attachments
#   S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from Supabase → Storage → S3 access keys
#
# A chunk travels as base64 inside a JSON body, which inflates it by a third.
# Vercel rejects request bodies over 4.5 MB, so the 5 MB default would fail
# every chunk upload: 5 MB → ~6.8 MB on the wire. 3 MB → ~4.1 MB, which fits.
# The client reads the size from the session response, so nothing else changes.
#   UPLOAD_CHUNK_SIZE_BYTES=3145728
#
# Requests arrive through Vercel's proxy, so client IPs come from
# X-Forwarded-For and rate limiting is wrong without this:
#   TRUST_PROXY=true
