# Orbit Field — environment template.
# Copy to .env and fill in. The API validates this at boot and refuses to start
# on anything missing or malformed, so a typo fails loudly at deploy time.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=debug

# --- data stores -----------------------------------------------------------
DATABASE_URL=postgresql://orbit:orbit_dev_password@localhost:5432/orbit_field?schema=public
REDIS_URL=redis://localhost:6379

# --- secrets ---------------------------------------------------------------
# Generate each independently:  openssl rand -base64 48
# The access and refresh secrets MUST differ — the API refuses to start in
# production if they match, because a single secret lets an access token be
# replayed as a refresh token.
JWT_ACCESS_SECRET=replace-me-with-48-bytes-of-base64-entropy-aaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48-bytes-of-entropy-bbbbbbbb
OTP_SECRET=replace-me-with-another-48-bytes-of-entropy-cccccccccccc

JWT_ISSUER=orbit-field
JWT_AUDIENCE=orbit-field-clients
# Short-lived by design; offline devices rely on the refresh token.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REMEMBER_ME_TTL_DAYS=180

OTP_TTL_SECONDS=600
OTP_LENGTH=6

# --- object storage --------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3 / MinIO / R2
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orbit-attachments
S3_ACCESS_KEY_ID=orbitadmin
S3_SECRET_ACCESS_KEY=orbitadmin_dev_secret
S3_FORCE_PATH_STYLE=true

# 5 MB chunks: small enough to resume cheaply on a bad link, large enough that
# a 40 MB video is not 400 round trips.
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_SESSION_TTL_HOURS=72
MAX_UPLOAD_BYTES=524288000

# --- sync tuning -----------------------------------------------------------
SYNC_PUSH_MAX_OPERATIONS=500
SYNC_PULL_MAX_CHANGES=1000
# A device offline longer than this is forced to re-bootstrap. Set it longer
# than your longest realistic field deployment.
SYNC_CHANGELOG_RETENTION_DAYS=90
SYNC_IDEMPOTENCY_RETENTION_DAYS=30

# --- security --------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=10
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# Must be an explicit allowlist in production — '*' is rejected at boot.
CORS_ORIGINS=*
# Only enable behind a real proxy; otherwise callers can spoof their IP and
# defeat rate limiting.
TRUST_PROXY=false

# --- notifications ---------------------------------------------------------
SMTP_URL=
MAIL_FROM=Orbit Field <no-reply@orbitfield.app>
EXPO_ACCESS_TOKEN=
