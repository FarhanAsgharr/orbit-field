// Orbit Field — PostgreSQL schema.
//
// Two decisions drive most of this file:
//
//  1. Every primary key is a client-generatable ULID stored as `String`, not a
//     database-generated integer. A device in a basement mints the key; the
//     server accepts it. That is what makes offline creation possible without a
//     later id-rewriting pass.
//
//  2. Every syncable table carries `version` (optimistic concurrency) and
//     `syncCursor` (delta pull ordering), and nothing is hard-deleted. A device
//     that is offline when a row is deleted must still learn about the deletion
//     when it returns, and a tombstone is the only way to replicate that.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// `directUrl` matters only on a pooled deployment, and there it is not optional.
//
// Supabase fronts Postgres with a transaction-mode pooler on 6543. Serverless
// functions must go through it — each concurrent invocation is its own client,
// and a few hundred of them would exhaust the direct connection limit. But a
// transaction pooler cannot run DDL or advisory locks, so `prisma migrate`
// against it fails partway through and leaves the schema half-applied.
//
// So: `url` is the pooled connection the API uses, `directUrl` is the 5432
// connection migrations use. Locally both point at the same server and the
// distinction costs nothing.
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, pg_trgm]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPERVISOR
  INSPECTOR
  TECHNICIAN
  VIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum InspectionStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  ARCHIVED
}

enum InspectionOutcome {
  PASS
  PASS_WITH_OBSERVATIONS
  FAIL
  NOT_APPLICABLE
  PENDING
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum FieldType {
  TEXT
  TEXT_AREA
  NUMBER
  CURRENCY
  CHECKBOX
  RADIO
  DROPDOWN
  MULTI_SELECT
  DATE
  TIME
  DATETIME
  RATING
  PASS_FAIL
  YES_NO
  SIGNATURE
  GPS
  PHOTO
  VIDEO
  AUDIO
  FILE
  BARCODE
  INSTRUCTION
}

enum AttachmentKind {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
  SIGNATURE
  REPORT_PDF
}

enum AttachmentState {
  LOCAL_ONLY
  QUEUED
  UPLOADING
  FINALIZING
  UPLOADED
  FAILED
  EVICTABLE
}

enum SignatureRole {
  INSPECTOR
  CUSTOMER
  SUPERVISOR
  WITNESS
}

enum SyncEntity {
  ORGANIZATION
  USER
  PROJECT
  CLIENT
  SITE
  ASSET
  TEMPLATE_VERSION
  INSPECTION
  RESPONSE
  ATTACHMENT
  SIGNATURE
  NOTIFICATION
}

enum SyncOperationType {
  CREATE
  UPDATE
  DELETE
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  DEVICE_ENROLMENT
  STEP_UP_AUTH
  // Single-use sign-in link. Stored here rather than as a bare signed token so
  // that consuming it is a database write — a JWT alone cannot be invalidated
  // once issued, and a sign-in link that still works after use is a credential
  // sitting in an inbox forever.
  MAGIC_LINK
}

enum NotificationChannel {
  PUSH
  LOCAL
  EMAIL
  IN_APP
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String  @id @db.VarChar(26)
  name      String  @db.VarChar(200)
  slug      String  @unique @db.VarChar(80)
  logoUrl   String? @db.VarChar(500)
  timezone  String  @default("UTC") @db.VarChar(64)
  locale    String  @default("en") @db.VarChar(16)
  currency  String  @default("USD") @db.VarChar(3)

  // Org-level toggles: GPS enforcement, password policy, retention, branding.
  settings  Json    @default("{}")

  // Per-org monotonic counter handed out to every accepted mutation. Kept on the
  // org row and bumped inside the same transaction as the write, so a delta pull
  // can never observe a gap or an out-of-order cursor.
  syncSequence BigInt @default(0)

  // Per-year inspection numbering, e.g. INS-2026-000001.
  numberPrefix   String @default("INS") @db.VarChar(8)
  numberSequence Int    @default(0)
  numberYear     Int    @default(0)

  isActive  Boolean  @default(true)
  version   Int      @default(1)
  syncCursor BigInt  @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  users         User[]
  devices       Device[]
  projects      Project[]
  clients       Client[]
  sites         Site[]
  assets        Asset[]
  templates     Template[]
  inspections   Inspection[]
  responses     InspectionResponse[]
  attachments   Attachment[]
  signatures    Signature[]
  auditLogs     AuditLog[]
  changeLog     ChangeLogEntry[]
  notifications Notification[]
  reports       Report[]
  syncSessions  SyncSession[]

  @@index([slug])
  @@map("organizations")
}

model User {
  id             String  @id @db.VarChar(26)
  orgId          String  @db.VarChar(26)
  email          String  @db.VarChar(320)
  emailVerifiedAt DateTime? @db.Timestamptz(6)
  phone          String? @db.VarChar(32)
  firstName      String  @db.VarChar(100)
  lastName       String  @db.VarChar(100)
  avatarUrl      String? @db.VarChar(500)

  // Argon2id hash. Never leaves the server, never appears in a select-all.
  passwordHash   String? @db.VarChar(255)
  // Previous hashes, newest first, for password-reuse enforcement.
  passwordHistory Json   @default("[]")
  passwordChangedAt DateTime? @db.Timestamptz(6)

  role           Role       @default(INSPECTOR)
  extraPermissions   String[] @default([])
  revokedPermissions String[] @default([])
  status         UserStatus @default(INVITED)

  department     String? @db.VarChar(120)
  jobTitle       String? @db.VarChar(120)
  registrationNumber String? @db.VarChar(80)
  timezone       String? @db.VarChar(64)
  locale         String? @db.VarChar(16)

  // Per-user push preferences: enabled categories, quiet hours, sound.
  // Stored as JSON because it is read and written whole and never queried by
  // its internals.
  notificationPreferences Json @default("{}")

  // Brute-force protection, evaluated before the password is even hashed.
  failedLoginAttempts Int @default(0)
  lockedUntil    DateTime? @db.Timestamptz(6)
  lastLoginAt    DateTime? @db.Timestamptz(6)
  lastLoginIp    String?   @db.Inet

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  devices            Device[]
  refreshTokens      RefreshToken[]
  otpCodes           OtpCode[]
  projectMemberships ProjectMember[]
  managedProjects    Project[]           @relation("ProjectManager")
  assignedInspections Inspection[]       @relation("InspectionAssignee")
  createdInspections  Inspection[]       @relation("InspectionCreator")
  reviewedInspections Inspection[]       @relation("InspectionReviewer")
  auditLogs          AuditLog[]
  notifications      Notification[]
  createdTemplates   Template[]
  syncSessions       SyncSession[]
  conflicts          SyncConflictRecord[]

  // Email is unique per organisation, not globally — the same contractor may
  // legitimately hold accounts with two client organisations.
  @@unique([orgId, email])
  @@index([orgId, role])
  @@index([orgId, status])
  @@index([email])
  @@map("users")
}

model Device {
  id             String  @id @db.VarChar(26)
  orgId          String  @db.VarChar(26)
  userId         String  @db.VarChar(26)
  installationId String  @db.VarChar(128)
  name           String  @db.VarChar(120)
  platform       String  @db.VarChar(16)
  osVersion      String  @db.VarChar(40)
  appVersion     String  @db.VarChar(40)
  model          String? @db.VarChar(80)

  pushToken      String? @db.VarChar(400)
  // SPKI public key from the secure enclave, used for biometric login. The
  // private half never leaves the device, so a stolen database cannot forge it.
  biometricPublicKey String? @db.Text
  biometricEnrolledAt DateTime? @db.Timestamptz(6)

  lastSyncCursor BigInt   @default(0)
  lastSeenAt     DateTime? @db.Timestamptz(6)
  lastSyncAt     DateTime? @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  revokedReason  String?   @db.VarChar(200)

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  syncSessions  SyncSession[]

  @@unique([userId, installationId])
  @@index([orgId, userId])
  @@index([pushToken])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String   @id @db.VarChar(26)
  userId    String   @db.VarChar(26)
  deviceId  String?  @db.VarChar(26)

  // SHA-256 of the token. Storing the raw token would make a database leak
  // equivalent to handing out live sessions.
  tokenHash String   @unique @db.VarChar(64)

  // Rotation chain: each refresh issues a successor and marks its parent used.
  // Presenting an already-used token means the token was stolen, so the whole
  // family is revoked. This is the standard reuse-detection defence.
  familyId  String   @db.VarChar(26)
  usedAt    DateTime? @db.Timestamptz(6)
  replacedById String? @db.VarChar(26)

  expiresAt DateTime @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  revokedReason String? @db.VarChar(120)
  userAgent String?  @db.VarChar(400)
  ipAddress String?  @db.Inet
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String     @id @db.VarChar(26)
  userId    String     @db.VarChar(26)
  purpose   OtpPurpose
  // HMAC of the code, so a database read cannot reveal a live OTP.
  codeHash  String     @db.VarChar(64)
  attempts  Int        @default(0)
  maxAttempts Int      @default(5)
  expiresAt DateTime   @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  ipAddress String?    @db.Inet

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model Client {
  id      String  @id @db.VarChar(26)
  orgId   String  @db.VarChar(26)
  name    String  @db.VarChar(200)
  code    String? @db.VarChar(40)
  contactName  String? @db.VarChar(120)
  contactEmail String? @db.VarChar(320)
  contactPhone String? @db.VarChar(32)
  address String? @db.Text
  logoUrl String? @db.VarChar(500)
  isActive Boolean @default(true)

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects     Project[]
  sites        Site[]
  inspections  Inspection[]

  @@unique([orgId, code])
  @@index([orgId, isActive])
  @@index([orgId, syncCursor])
  @@map("clients")
}

model Project {
  id          String  @id @db.VarChar(26)
  orgId       String  @db.VarChar(26)
  clientId    String? @db.VarChar(26)
  name        String  @db.VarChar(200)
  code        String  @db.VarChar(40)
  description String? @db.Text
  startDate   DateTime? @db.Timestamptz(6)
  endDate     DateTime? @db.Timestamptz(6)
  managerId   String? @db.VarChar(26)
  isActive    Boolean @default(true)

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager      User?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  sites        Site[]
  inspections  Inspection[]

  @@unique([orgId, code])
  @@index([orgId, isActive])
  @@index([orgId, syncCursor])
  @@map("projects")
}

model ProjectMember {
  projectId String   @db.VarChar(26)
  userId    String   @db.VarChar(26)
  addedAt   DateTime @default(now()) @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Site {
  id        String  @id @db.VarChar(26)
  orgId     String  @db.VarChar(26)
  projectId String? @db.VarChar(26)
  clientId  String? @db.VarChar(26)
  name      String  @db.VarChar(200)
  code      String? @db.VarChar(40)
  address   String? @db.Text
  latitude  Float?
  longitude Float?
  geofenceRadiusMeters Int?
  timezone  String? @db.VarChar(64)
  contactName String? @db.VarChar(120)
  contactPhone String? @db.VarChar(32)
  isActive  Boolean @default(true)

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assets       Asset[]
  inspections  Inspection[]

  @@index([orgId, isActive])
  @@index([orgId, syncCursor])
  @@index([latitude, longitude])
  @@map("sites")
}

model Asset {
  id            String  @id @db.VarChar(26)
  orgId         String  @db.VarChar(26)
  siteId        String? @db.VarChar(26)
  parentAssetId String? @db.VarChar(26)
  name          String  @db.VarChar(200)
  tag           String  @db.VarChar(120)
  category      String? @db.VarChar(120)
  manufacturer  String? @db.VarChar(120)
  model         String? @db.VarChar(120)
  serialNumber  String? @db.VarChar(120)
  installedAt   DateTime? @db.Timestamptz(6)
  latitude      Float?
  longitude     Float?
  metadata      Json    @default("{}")
  isActive      Boolean @default(true)

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  parent       Asset?       @relation("AssetHierarchy", fields: [parentAssetId], references: [id], onDelete: SetNull)
  children     Asset[]      @relation("AssetHierarchy")
  inspections  Inspection[]

  @@unique([orgId, tag])
  @@index([orgId, siteId])
  @@index([orgId, syncCursor])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

model Template {
  id          String  @id @db.VarChar(26)
  orgId       String  @db.VarChar(26)
  name        String  @db.VarChar(200)
  description String? @db.Text
  category    String? @db.VarChar(120)
  discipline  String? @db.VarChar(120)
  defaultPriority Priority @default(NORMAL)
  activeVersionId String? @db.VarChar(26)
  isArchived  Boolean @default(false)
  createdById String  @db.VarChar(26)

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  versions     TemplateVersion[]
  inspections  Inspection[]

  @@index([orgId, isArchived])
  @@index([orgId, syncCursor])
  @@map("templates")
}

// A published version is immutable. Editing produces a new row, so an inspection
// in progress can never have its questions changed underneath the inspector.
model TemplateVersion {
  id         String @id @db.VarChar(26)
  templateId String @db.VarChar(26)
  orgId      String @db.VarChar(26)
  version    Int

  // The full section/field tree, denormalised. Stored as one JSON document
  // because it is always read and written whole, and because a device pulling a
  // template needs exactly this blob — no join fan-out over a slow link.
  definition Json

  scoring    Json   @default("{}")
  requiredSignatures String[] @default([])

  publishedAt DateTime? @db.Timestamptz(6)
  publishedById String? @db.VarChar(26)
  retiredAt   DateTime? @db.Timestamptz(6)
  changeNote  String?  @db.Text

  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  template    Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  inspections Inspection[]

  @@unique([templateId, version])
  @@index([orgId, syncCursor])
  @@map("template_versions")
}

// ---------------------------------------------------------------------------
// Inspections
// ---------------------------------------------------------------------------

model Inspection {
  id     String @id @db.VarChar(26)
  orgId  String @db.VarChar(26)
  number String @db.VarChar(40)

  templateId        String @db.VarChar(26)
  templateVersionId String @db.VarChar(26)

  projectId String? @db.VarChar(26)
  clientId  String? @db.VarChar(26)
  siteId    String? @db.VarChar(26)
  assetId   String? @db.VarChar(26)

  title    String            @db.VarChar(300)
  status   InspectionStatus  @default(DRAFT)
  outcome  InspectionOutcome @default(PENDING)
  priority Priority          @default(NORMAL)
  category   String? @db.VarChar(120)
  department String? @db.VarChar(120)

  assignedToId String? @db.VarChar(26)
  createdById  String  @db.VarChar(26)
  reviewedById String? @db.VarChar(26)

  startedAt    DateTime? @db.Timestamptz(6)
  scheduledFor DateTime? @db.Timestamptz(6)
  dueAt        DateTime? @db.Timestamptz(6)
  completedAt  DateTime? @db.Timestamptz(6)
  submittedAt  DateTime? @db.Timestamptz(6)
  reviewedAt   DateTime? @db.Timestamptz(6)
  rejectionReason String? @db.Text

  startLocation Json?
  endLocation   Json?
  distanceFromSiteMeters Float?

  notes String? @db.Text
  tags  String[] @default([])

  score           Float?
  totalFields     Int @default(0)
  answeredFields  Int @default(0)
  failedFields    Int @default(0)
  criticalFailures Int @default(0)

  isArchived Boolean @default(false)
  duplicatedFromId String? @db.VarChar(26)

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template        Template        @relation(fields: [templateId], references: [id])
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id])
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  site            Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  asset           Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignedTo      User?           @relation("InspectionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       User            @relation("InspectionCreator", fields: [createdById], references: [id])
  reviewedBy      User?           @relation("InspectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  responses   InspectionResponse[]
  attachments Attachment[]
  signatures  Signature[]
  reports     Report[]

  @@unique([orgId, number])
  // The dominant query is "my open inspections, newest first".
  @@index([orgId, assignedToId, status])
  @@index([orgId, status, dueAt])
  @@index([orgId, syncCursor])
  @@index([orgId, siteId])
  @@index([orgId, templateId])
  @@index([orgId, createdAt])
  @@map("inspections")
}

model InspectionResponse {
  id           String @id @db.VarChar(26)
  orgId        String @db.VarChar(26)
  inspectionId String @db.VarChar(26)
  sectionId    String @db.VarChar(26)
  fieldId      String @db.VarChar(26)
  repeatIndex  Int    @default(0)

  // Polymorphic by field type: scalar, option value, string[], or a GeoPoint.
  value   Json?
  comment String? @db.Text

  score            Float?
  isFailure        Boolean @default(false)
  isNotApplicable  Boolean @default(false)
  location         Json?
  answeredAt       DateTime? @db.Timestamptz(6)
  answeredById     String? @db.VarChar(26)

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  // One answer per field per repeat instance. This is what makes an upsert from
  // a replayed offline operation idempotent.
  @@unique([inspectionId, fieldId, repeatIndex])
  @@index([orgId, syncCursor])
  @@index([inspectionId])
  @@map("inspection_responses")
}

model Attachment {
  id           String  @id @db.VarChar(26)
  orgId        String  @db.VarChar(26)
  inspectionId String? @db.VarChar(26)
  responseId   String? @db.VarChar(26)

  kind  AttachmentKind
  state AttachmentState @default(LOCAL_ONLY)

  fileName  String @db.VarChar(255)
  mimeType  String @db.VarChar(120)
  sizeBytes BigInt

  // SHA-256 of the original bytes. Doubles as the dedupe key: the same photo
  // attached twice uploads once.
  checksum String @db.VarChar(64)

  width      Int?
  height     Int?
  durationMs Int?

  storageKey          String? @db.VarChar(500)
  thumbnailStorageKey String? @db.VarChar(500)

  location    Json?
  capturedAt  DateTime? @db.Timestamptz(6)
  caption     String?   @db.Text
  pairTag     String?   @db.VarChar(20)
  annotations Json?

  uploadedAt      DateTime? @db.Timestamptz(6)
  uploadAttempts  Int       @default(0)
  lastUploadError String?   @db.Text

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inspection   Inspection?         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  response     InspectionResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  uploadSession UploadSession?
  signature     Signature?

  @@index([orgId, syncCursor])
  @@index([inspectionId])
  @@index([responseId])
  @@index([orgId, checksum])
  @@index([state])
  @@map("attachments")
}

model UploadSession {
  id           String @id @db.VarChar(26)
  orgId        String @db.VarChar(26)
  attachmentId String @unique @db.VarChar(26)
  deviceId     String @db.VarChar(26)

  chunkSize   Int
  totalChunks Int
  totalBytes  BigInt
  // Indices durably persisted. A device that dies mid-upload resumes from here
  // rather than re-sending 30 MB over a 2G link.
  receivedChunks Int[] @default([])
  storageUploadId String? @db.VarChar(255)

  expiresAt  DateTime  @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([orgId, deviceId])
  @@map("upload_sessions")
}

model Signature {
  id           String        @id @db.VarChar(26)
  orgId        String        @db.VarChar(26)
  inspectionId String        @db.VarChar(26)
  role         SignatureRole
  signerName   String        @db.VarChar(200)
  signerTitle  String?       @db.VarChar(120)
  signerEmail  String?       @db.VarChar(320)
  attachmentId String?       @unique @db.VarChar(26)
  strokes      Json?
  signedAt     DateTime      @db.Timestamptz(6)
  location     Json?
  declaration  String?       @db.Text

  version    Int      @default(1)
  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  lastWriterDeviceId String? @db.VarChar(26)
  lastWriterUserId   String? @db.VarChar(26)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  attachment   Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@unique([inspectionId, role])
  @@index([orgId, syncCursor])
  @@map("signatures")
}

model Report {
  id           String @id @db.VarChar(26)
  orgId        String @db.VarChar(26)
  inspectionId String @db.VarChar(26)
  layout       String @default("default") @db.VarChar(80)
  storageKey   String? @db.VarChar(500)
  sizeBytes    BigInt?
  checksum     String? @db.VarChar(64)
  // Set when generated on-device so the app can show it before it uploads.
  generatedOnDevice Boolean @default(false)
  generatedById String  @db.VarChar(26)
  generatedAt   DateTime @default(now()) @db.Timestamptz(6)
  locale        String   @default("en") @db.VarChar(16)
  options       Json     @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([orgId, inspectionId])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Sync machinery
// ---------------------------------------------------------------------------

// Append-only log of every accepted mutation. This is what a delta pull reads:
// "give me everything for my org with cursor > N". Keeping it separate from the
// entity tables means a pull is one indexed range scan instead of a dozen
// per-table queries with per-table watermarks.
model ChangeLogEntry {
  // Cursors are allocated from a PER-ORGANISATION sequence, so `cursor` alone
  // is not unique across the table — two organisations both legitimately hold
  // cursor 1. The primary key must be the pair. (A global `@id` on cursor made
  // the second organisation to register fail on its first replicated write.)
  cursor    BigInt
  orgId     String            @db.VarChar(26)
  entity    SyncEntity
  operation SyncOperationType
  entityId  String            @db.VarChar(26)
  version   Int

  // Row snapshot at the time of the change. Denormalising costs storage but
  // means a pull never has to join back to a row that has since moved on.
  data Json?

  // Scoping columns, so a pull can filter to what this user is allowed to see
  // without loading and inspecting every payload.
  projectId    String? @db.VarChar(26)
  assignedToId String? @db.VarChar(26)

  actorUserId   String? @db.VarChar(26)
  actorDeviceId String? @db.VarChar(26)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Composite key. Doubles as the index delta pull scans, so no separate
  // @@index([orgId, cursor]) is needed.
  @@id([orgId, cursor])
  @@index([orgId, entity, cursor])
  @@index([createdAt])
  @@map("change_log")
}

// Idempotency ledger. A device that pushes, loses the response, and retries must
// not create a second inspection. The operation id is minted on the device and
// recorded here on first application; a replay returns the stored result.
model SyncOperationRecord {
  id       String            @id @db.VarChar(26)
  orgId    String            @db.VarChar(26)
  deviceId String            @db.VarChar(26)
  userId   String            @db.VarChar(26)
  entity   SyncEntity
  operation SyncOperationType
  entityId String            @db.VarChar(26)

  status       String   @db.VarChar(24)
  resultVersion Int?
  resultCursor BigInt?
  errorCode    String?  @db.VarChar(60)
  errorMessage String?  @db.Text

  lamport   Int
  appliedAt DateTime @default(now()) @db.Timestamptz(6)
  // Rows older than the retention window are pruned; a device offline longer
  // than that is forced into a full resync anyway.
  expiresAt DateTime @db.Timestamptz(6)

  @@index([orgId, deviceId, appliedAt])
  @@index([expiresAt])
  @@map("sync_operations")
}

model SyncConflictRecord {
  id        String     @id @db.VarChar(26)
  orgId     String     @db.VarChar(26)
  operationId String   @db.VarChar(26)
  deviceId  String     @db.VarChar(26)
  userId    String     @db.VarChar(26)
  entity    SyncEntity
  entityId  String     @db.VarChar(26)

  baseVersion   Int?
  serverVersion Int
  localRecord   Json
  serverRecord  Json
  diffs         Json

  resolvedAt     DateTime? @db.Timestamptz(6)
  resolvedById   String?   @db.VarChar(26)
  resolutionStrategy String? @db.VarChar(20)
  resolvedRecord Json?

  detectedAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, resolvedAt])
  @@index([orgId, entityId])
  @@map("sync_conflicts")
}

// Per-run diagnostics. When a field engineer reports "it did not sync", this is
// the table support looks at first.
model SyncSession {
  id       String @id @db.VarChar(26)
  orgId    String @db.VarChar(26)
  deviceId String @db.VarChar(26)
  userId   String @db.VarChar(26)

  trigger      String  @db.VarChar(24)
  cursorBefore BigInt
  cursorAfter  BigInt?
  pushedCount  Int     @default(0)
  pulledCount  Int     @default(0)
  conflictCount Int    @default(0)
  bytesUp      BigInt  @default(0)
  bytesDown    BigInt  @default(0)
  outcome      String? @db.VarChar(16)
  error        String? @db.Text
  appVersion   String? @db.VarChar(40)
  networkType  String? @db.VarChar(24)

  startedAt  DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  durationMs Int?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([deviceId, startedAt])
  @@map("sync_sessions")
}

// ---------------------------------------------------------------------------
// Audit & notifications
// ---------------------------------------------------------------------------

model AuditLog {
  id       String  @id @db.VarChar(26)
  orgId    String  @db.VarChar(26)
  userId   String? @db.VarChar(26)
  deviceId String? @db.VarChar(26)

  action     String  @db.VarChar(60)
  entity     String? @db.VarChar(40)
  entityId   String? @db.VarChar(26)
  // Before/after snapshot for record mutations, redacted of secret fields.
  changes    Json?
  metadata   Json?
  ipAddress  String? @db.Inet
  userAgent  String? @db.VarChar(400)
  requestId  String? @db.VarChar(40)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, action, createdAt])
  @@index([orgId, entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id      String              @id @db.VarChar(26)
  orgId   String              @db.VarChar(26)
  userId  String              @db.VarChar(26)
  topic   String              @db.VarChar(60)
  channel NotificationChannel @default(PUSH)

  title    String  @db.VarChar(200)
  body     String  @db.Text
  data     Json    @default("{}")
  deepLink String? @db.VarChar(300)

  readAt      DateTime? @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)
  failedAt    DateTime? @db.Timestamptz(6)
  failureReason String? @db.VarChar(300)

  syncCursor BigInt   @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([orgId, syncCursor])
  @@map("notifications")
}
